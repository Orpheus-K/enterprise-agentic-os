{
  "name": "agentos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @agentos/web dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.tools.json && pnpm -r --if-present typecheck",
    "boundaries": "depcruise apps/web/src packages/ui/src packages/api-client/src --config dependency-cruiser.config.mjs --output-type err-long",
    "test:e2e": "playwright test",
    "test:db": "node scripts/tasks.mjs database",
    "db:migrate": "node scripts/tasks.mjs migrate",
    "test": "vitest run",
    "build": "node scripts/tasks.mjs build",
    "check": "node scripts/tasks.mjs check",
    "check:go": "node scripts/tasks.mjs go",
    "check:python": "node scripts/tasks.mjs python",
    "start": "node scripts/tasks.mjs start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.6.0",
    "jsdom": "26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
